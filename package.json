{
  "name": "a-design-system",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm clean && pnpm -r --if-present build",
    "dev": "pnpm --filter @a-design-system/docs dev",
    "docs:dev": "pnpm --filter @a-design-system/docs dev",
    "docs:build": "pnpm --filter @a-design-system/docs build",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm test:tooling && pnpm build && pnpm generate:cem && pnpm check:cem && pnpm generate:api && pnpm check:api && pnpm check:runtime && pnpm check:docs && pnpm typecheck && pnpm test && pnpm check:packages",
    "test": "pnpm -r --if-present test",
    "test:browser": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "node scripts/clean.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "lint": "pnpm --filter @a-design-system/lint exec eslint ../.. --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:tooling": "node --test tools/lint/*.test.mjs",
    "check:cem": "node scripts/check-cem.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:api": "node scripts/check-api-snapshot.mjs",
    "generate:cem": "node scripts/generate-cem.mjs",
    "generate:api": "node scripts/generate-api-snapshot.mjs",
    "ads": "node scripts/tokens-cli.mjs",
    "tokens:validate": "node scripts/tokens-cli.mjs validate packages/tokens/src/tokens.json",
    "tokens:build": "node scripts/tokens-cli.mjs build packages/tokens/src/tokens.json",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:pre": "changeset pre enter next",
    "release:exit-pre": "changeset pre exit",
    "release:version": "changeset version && pnpm install --lockfile-only && pnpm format",
    "release:pack": "pnpm build && node scripts/pack-release.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
