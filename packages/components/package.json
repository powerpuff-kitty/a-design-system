{
  "name": "@a-design-system/components",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": true,
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@a-design-system/core": "workspace:*",
    "lit": "^3.3.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./src/button.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./src/input.ts",
      "import": "./dist/input.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": ["dist", "src"]
}
