{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" } },
      "1000": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.035, 0.035, 0.04], "alpha": 1, "hex": "#09090a" } }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.neutral.0}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.1000}" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.neutral.1000}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.0}" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
      "normal": { "$type": "duration", "$value": { "value": 180, "unit": "ms" } }
    }
  }
}
